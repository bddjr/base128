{
  "name": "base128-ascii",
  "version": "6.2.3",
  "author": "bddjr",
  "description": "Smaller than base64, only use ASCII, can run in web browser.",
  "license": "Unlicense",
  "type": "module",
  "main": "src/main.cjs",
  "types": "src/main.d.ts",
  "browser": "src/browser.mjs",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "node-gyp rebuild",
    "check": "es-check es6 --checkFeatures --module src/main.cjs src/browser.mjs src/mini-decode.mjs && tsc",
    "test": "pnpm check && pnpm build && node scripts/test.mjs",
    "test:nobuild": "pnpm check && node scripts/test.mjs",
    "test:only": "node scripts/test.mjs",
    "test:deno": "deno run --allow-all scripts/test.mjs",
    "test:bun": "bun scripts/test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bddjr/base128.git"
  },
  "homepage": "https://bddjr.github.io/base128/",
  "keywords": [
    "base128",
    "base64",
    "base",
    "ascii",
    "encode",
    "decode",
    "atob",
    "btoa",
    "base128-ascii",
    "base128jstl"
  ],
  "devDependencies": {
    "base128-ascii": "link:",
    "es-check": "^9.8.1",
    "node-addon-api": "^8.9.2",
    "node-api-headers": "^1.9.0",
    "node-gyp": "^13.1.0",
    "typescript": "^6.0.3"
  }
}